{
  "name": "savesync",
  "version": "0.1.1",
  "description": "Versionamento e sincronização self-hosted de saves de jogos.",
  "author": "GaussNoob",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "node-notifier": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run dashboard:dev\"",
    "electron:dev": "concurrently \"npm run server:dev\" \"npm run dashboard:dev\" \"wait-on http://localhost:3000 http://localhost:5173 && electron electron/main.js --dev\"",
    "electron:start": "npm run build && electron electron/main.js",
    "dist:win": "node scripts/build-windows.js",
    "server:dev": "node --watch server/index.js",
    "dashboard:dev": "vite --host 0.0.0.0 --config dashboard/vite.config.js",
    "build": "vite build --config dashboard/vite.config.js",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:build": "npm run android:sync && node scripts/build-android.js",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/chakra-petch": "^5.3.0",
    "@lucide/vue": "^1.27.0",
    "@vueuse/core": "^14.3.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "motion-v": "^2.3.0",
    "node-notifier": "^10.0.1",
    "radix-vue": "^1.9.17",
    "vue-virtual-scroller": "^3.0.4",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "^41.10.2",
    "pinia": "^3.0.4",
    "postcss": "^8.5.19",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@41.10.2": true,
    "esbuild@0.28.1": true
  }
}
